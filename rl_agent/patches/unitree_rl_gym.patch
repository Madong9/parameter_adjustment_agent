+
+    def _reward_jump_height(self):
+        """按相对标称高度的垂直位移给分，并在配置目标处饱和。"""
+        displacement = self.base_pos[:, 2] - self.cfg.init_state.pos[2]
+        return torch.clamp(displacement / max(self.cfg.rewards.jump_height_target, 1e-6), min=0.0, max=1.0)
+
+    def _reward_feet_synchrony(self):
+        """奖励预期的同步接触状态，即四足全部着地或全部离地。"""
+        contacts = self.contact_forces[:, self.feet_indices, 2] > 1.0
+        contact_count = torch.sum(contacts, dim=1)
+        return torch.logical_or(contact_count == 0, contact_count == len(self.feet_indices)).float()
+
+    def _reward_landing_stability(self):
+        """奖励腾空阶段结束后四足接触且机身保持水平的状态。"""
+        contacts = self.contact_forces[:, self.feet_indices, 2] > 1.0
+        all_contact = torch.all(contacts, dim=1).float()
+        return all_contact * torch.exp(-4.0 * torch.sum(torch.square(self.rpy[:, :2]), dim=1))
+
+    def _reward_horizontal_drift(self):
+        """计算机身相对环境原点的水平漂移惩罚量。"""
+        return torch.norm(self.base_pos[:, :2] - self.env_origins[:, :2], dim=1)
+
+    def _reward_rear_leg_stand(self):
+        """奖励后足支撑、前足离地且接近目标高度和俯仰角的持续站立姿态。"""
+        contacts = self.contact_forces[:, self.feet_indices, 2] > 1.0
+        rear_support = torch.mean(contacts[:, 2:4].float(), dim=1)
+        front_air_fraction = 1.0 - torch.mean(contacts[:, 0:2].float(), dim=1)
+        height_error = (self.base_pos[:, 2] - self.cfg.rewards.rear_stand_height_target) \
+            / max(self.cfg.rewards.rear_stand_height_sigma, 1e-6)
+        pitch_error = (torch.abs(self.rpy[:, 1]) - self.cfg.rewards.rear_stand_pitch_target) \
+            / max(self.cfg.rewards.rear_stand_pitch_sigma, 1e-6)
+        height_score = torch.exp(-torch.square(height_error))
+        pitch_score = torch.exp(-torch.square(pitch_error))
+        pitch_progress = torch.clamp(
+            torch.abs(self.rpy[:, 1]) / max(self.cfg.rewards.rear_stand_pitch_target, 1e-6), 0.0, 1.0)
+        roll_score = torch.exp(-4.0 * torch.square(self.rpy[:, 0]))
+        dense_progress = 0.15 * height_score + 0.15 * pitch_progress
