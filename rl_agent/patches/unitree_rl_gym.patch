+        front_air_fraction = 1.0 - torch.mean(contacts[:, 0:2].float(), dim=1)
+        return rear_support * front_air_fraction * self._reward_rear_leg_stand() * self._reward_tracking_lin_vel()
+
+    def _reward_front_leg_stand(self):
