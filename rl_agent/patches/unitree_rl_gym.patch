+        height_error = (self.base_pos[:, 2] - self.cfg.rewards.front_stand_height_target) \
+            / max(self.cfg.rewards.front_stand_height_sigma, 1e-6)
+        pitch_error = (torch.abs(self.rpy[:, 1]) - self.cfg.rewards.front_stand_pitch_target) \
+            / max(self.cfg.rewards.front_stand_pitch_sigma, 1e-6)
+        height_score = torch.exp(-torch.square(height_error))
+        pitch_score = torch.exp(-torch.square(pitch_error))
+        pitch_progress = torch.clamp(
+            torch.abs(self.rpy[:, 1]) / max(self.cfg.rewards.front_stand_pitch_target, 1e-6), 0.0, 1.0)
+        roll_score = torch.exp(-4.0 * torch.square(self.rpy[:, 0]))
+        dense_progress = 0.15 * height_score + 0.15 * pitch_progress
+        target_posture = 0.70 * rear_air_fraction * height_score * pitch_score
+        return front_support * (dense_progress + target_posture) * roll_score
+
+    def _reward_front_leg_walk(self):
+        """仅在前腿倒立姿态成立时奖励线速度跟踪，避免四足普通行走利用任务奖励。"""
+        contacts = self.contact_forces[:, self.feet_indices, 2] > 1.0
