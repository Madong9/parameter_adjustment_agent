# 复制为 .env 后填写。.env 已被 Git 忽略，请勿将真实密钥写入其他文件。
DASHSCOPE_API_KEY=
# 以下两项可选；仅当业务空间端点或模型 ID 不同时填写。
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_MODEL=glm-4.7

OPENCLI_PROFILE=
OPENCLI_SESSION=rl-training-agent
OPENCLI_BIND_EXISTING_TAB=true
CHATGPT_URL=https://chatgpt.com/
OPENCLI_CONNECT_TIMEOUT=20
OPENCLI_AUTO_LAUNCH_BROWSER=true
OPENCLI_BRIDGE_BROWSER_EXECUTABLE=
OPENCLI_COMMAND_TIMEOUT=30
OPENCLI_SUBMIT_TIMEOUT=45
OPENCLI_RESPONSE_TIMEOUT=180
OPENCLI_MAX_RETRIES=2
EXPERIMENT_ROOT=experiments
MAX_REWARD_REVISIONS=3
MAX_TOTAL_ITERATIONS=12000
NUM_REWARD_CANDIDATES=3
SMOKE_ITERATIONS=50
SCREENING_ITERATIONS=300
FULL_ITERATIONS=3000
EVALUATION_SEEDS=1,2,3
ROLLOUTS_PER_SEED=20
VIDEO_FPS=30
